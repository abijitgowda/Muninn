# Muninn — secrets only.
# Everything else (models, sources, watchlist) lives in wiki.yaml.

# Serve endpoint auth (optional — omit for no auth on localhost)
# MUNINN_API_TOKEN=

# LLM providers (only needed if llm_provider != ollama in wiki.yaml)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...

# X (formerly Twitter)
# Option 1 — Bearer token (timeline + replies only):
# X_BEARER_TOKEN=

# Option 2 — OAuth 1.0a (ALL endpoints: timeline + liked + replies + bookmarks):
# Generate all 4 at https://developer.x.com → your app → Keys and tokens
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=
